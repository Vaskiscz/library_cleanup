# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
# ...but app/wheels/ holds VENDORED wheels that are tracked in git — without
# this negation a re-bumped wheel would be silently ignored by `git add`.
!app/wheels/
*.egg-info

# Virtual environments
.venv

# Generated review reports
*-report.html
poc-*.html
cleanup-report.html

# Machine-specific launcher scripts (hardcoded absolute paths)
*.command

# One-off PoC / scratch scripts
poc_*.py

# macOS
.DS_Store

# Local tooling config — useful on disk, not needed in the public repo
.claude/
.design-sync/

# Local-only working docs (never publish)
AUDIT_PROMPTS.md
